# Copy to .secrets/dev and fill in the values. Everything in .secrets/ except this file stays out of git.
ANTHROPIC_API_KEY=

# GitHub App (client secret from the App's settings page) and the key that seals the session cookie.
GITHUB_CLIENT_SECRET=

# Hetzner Object Storage (S3-compatible). The endpoint must match the bucket's region.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_BUCKET=schnackenburg-archiv-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SESSION_SECRET: any long random string, e.g. `openssl rand -base64 32`. Changing it signs everybody out.
SESSION_SECRET=
